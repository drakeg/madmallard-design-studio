{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mad Mallard Design Studio",
  "version": "0.1.0",
  "identifier": "com.madmallard.designstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mad Mallard Design Studio",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ]
  }
}